PORT=3000
DATABASE_URL="mysql://user:password@localhost:3307/pentarium?connection_limit=5&pool_timeout=20"
JWT_SECRET="isi-dengan-string-acak-panjang"
MQTT_URL="mqtt://localhost:1883"
MQTT_ENABLED=true

# Resend (ganti re_xxxxxxxxx dengan API key asli dari dashboard Resend)
ALERT_EMAIL_ENABLED=true
RESEND_API_KEY="re_xxxxxxxxx"
ALERT_FROM_EMAIL="Pentarium IoT <onboarding@resend.dev>"
ALERT_TO_EMAIL="email-tujuan@example.com"

# Frontend base URL (untuk link verifikasi email)
APP_URL="http://localhost:5173"
